/* ---- 💫 https://github.com/LinuxBeginnings 💫 ---- */
/* Main Config - For Keybinds generation */

@import "~/.config/i3/rofi/config.rasi"  


/* ---- Mainbox ---- */
mainbox {
  children:
    [ "inputbar", "message", "listview"];
}

/* ---- Entry ---- */
entry {
  expand: true;
  placeholder: " 🧮 Search Keybinds";
}

/* ---- Listview ---- */
listview {
  columns: 2;
  lines: 8;
  fixed-height: false;
  scrollbar: true;
  spacing: 6px;
  cycle: true;
}

window {
  width: 90%;
  height: inherit;
}

/* ---- Elements ---- */
element {
  orientation: horizontal;
  margin: 0px;     /* (the default theme's row spacing: the card themes' bigger cards made */
  padding: 10px;   /*  these lists taller than a laptop screen) */
}

element-icon {
  	size: 0%;
}

element-text {
    horizontal-align: 0.0;
    vertical-align: 0.5;
    margin: 0px;
    padding: 0px;
}