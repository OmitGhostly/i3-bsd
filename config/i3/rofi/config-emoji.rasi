/* ---- 💫 https://github.com/LinuxBeginnings 💫 ---- */
/* Main Config - emoji */

@import "~/.config/i3/rofi/config.rasi" 

/* ---- Mainbox ---- */
mainbox {
  children:
    [ "inputbar", "message", "listview"];
}

/* ---- Window ---- */
window {
  width: inherit;
  height: inherit;
}

/* ---- Entry ---- */
entry {
  width: 37%;
  placeholder: " 💫 Search / Choose Emoji's";
  horizontal-align: 0.0;
}

/* ---- Listview ---- */
listview {
  columns: 2;
  lines: 7;
  fixed-height: false;
  scrollbar: true;
  spacing: 6px;
  cycle: true;
}

/* ---- Elements ---- */
element {
  orientation: horizontal;
  margin: 0px;     /* (the default theme's row spacing: the card themes' bigger cards made */
  padding: 10px;   /*  these lists taller than a laptop screen) */
}

element-icon {
  size: 0%;
}

element-text {
  horizontal-align: 0.0;
  vertical-align: 0.5;
  padding: 0px;
  margin: 0px;
}