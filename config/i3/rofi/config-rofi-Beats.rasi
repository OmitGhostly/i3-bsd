/* ---- 💫 https://github.com/LinuxBeginnings 💫 ---- */
/* Rofi Beats Config */

@import "~/.config/i3/rofi/config.rasi" 

/* ---- Window ---- */
window {
  width: inherit;
  height: inherit;
}

/* ---- Mainbox ---- */
mainbox {
  children:
    [ "inputbar", "listview"];
}

/* ---- Entry ---- */ 
entry {
  placeholder: "📻 Choose Media or Stations to play";
}

/* ---- Listview ---- */
listview {
  columns: 2;
  lines: 7;
  fixed-height: false;
  margin: 10px;
  scrollbar: true;
  spacing: 6px;
  cycle: true;
}

/* ---- Elements ---- */
element {
  orientation: horizontal;
  margin: 0px;     /* (the default theme's row spacing: the card themes' bigger cards made */
  padding: 10px;   /*  these lists taller than a laptop screen) */
}

element-icon {
  size: 0%;
}

element-text {
  horizontal-align: 0.0;
  vertical-align: 0.5;
  margin: 0px;
  padding: 0px;
}